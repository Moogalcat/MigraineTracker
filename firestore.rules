rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Only verified Google accounts listed in config/access (field "emails", lowercase) can sync.
    // No client can read or change config/access; edit it in the Firebase console.
    function canSync(userId) {
      return request.auth != null && request.auth.uid == userId
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in get(/databases/$(database)/documents/config/access).data.emails;
    }

    function isText(value, maxLength) {
      return value is string && value.size() <= maxLength;
    }

    function isOptionalText(value, maxLength) {
      return value == null || isText(value, maxLength);
    }

    function isRating(value) {
      return value == null || value in ['Mild', 'Moderate', 'Severe'];
    }

    function isShortList(value) {
      return value is list && value.size() <= 200;
    }

    // Rules cannot look inside list items, so these checks cap record shape, text lengths and list sizes.
    // The notes cap matches LogData.notesLimit in data.js and the notes editor's maxlength.
    function isEntry(entry, id) {
      return entry is map
        && entry.keys().hasOnly(['id', 'at', 'updatedAt', 'notes', 'triggers', 'auraIntensity', 'headacheIntensity'])
        && entry.keys().hasAll(['id', 'at', 'updatedAt', 'notes', 'triggers', 'auraIntensity', 'headacheIntensity'])
        && entry.id == id
        && isText(entry.at, 32) && isOptionalText(entry.updatedAt, 32)
        && isText(entry.notes, 50000)
        && isShortList(entry.triggers)
        && isRating(entry.auraIntensity) && isRating(entry.headacheIntensity);
    }

    function isEntryChange(data) {
      return data.keys().hasOnly(['kind', 'id', 'deleted', 'modifiedAt', 'entry', 'generation', 'deviceId'])
        && data.kind == 'entry' && isText(data.id, 128) && data.deleted == false && isEntry(data.entry, data.id);
    }

    function isDeletion(data) {
      return data.keys().hasOnly(['kind', 'id', 'deleted', 'modifiedAt', 'generation', 'deviceId'])
        && data.kind == 'entry' && isText(data.id, 128) && data.deleted == true;
    }

    function isSettings(data) {
      return data.keys().hasOnly(['kind', 'modifiedAt', 'customTriggers', 'preferences', 'generation', 'deviceId'])
        && data.kind == 'settings' && isShortList(data.customTriggers)
        && data.preferences is map && data.preferences.keys().hasOnly(['theme'])
        && data.preferences.theme in ['system', 'light', 'dark'];
    }

    function isChange(data) {
      return data.generation == 4 && isText(data.deviceId, 64) && isText(data.modifiedAt, 32)
        && (isEntryChange(data) || isDeletion(data) || isSettings(data));
    }

    match /users/{userId}/changes/{changeId} {
      allow read: if canSync(userId);
      allow create: if canSync(userId) && isChange(request.resource.data);
      // Clients may remove entry contents, never the deletion or settings records other devices rely on.
      allow delete: if canSync(userId)
        && (resource == null || ('entry' in resource.data && resource.data.get('deleted', false) != true));
      allow update: if false;
    }
  }
}
