# Keep the site out of search engines. This is not access control - anyone with
# the URL can still open it - it just stops it being indexed and found.
/*
  X-Robots-Tag: noindex, nofollow

# The service worker must never be served from a stale cache, or installed
# copies will not notice a new version.
/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Content-Type: application/manifest+json
